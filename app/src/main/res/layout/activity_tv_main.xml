<?xml version="1.0" encoding="utf-8"?>
<!-- TV Main Layout: Side Nav + Address Bar + Content Area
     All inside Overscan safe padding -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:id="@+id/safe_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/overscan_padding">

        <!-- ===== Side Navigation Bar ===== -->
        <LinearLayout
            android:id="@+id/side_nav"
            android:layout_width="@dimen/side_nav_width"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#141414"
            android:gravity="center_horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/nav_home"
                style="@style/TVNavItem"
                android:src="@drawable/ic_home"
                android:contentDescription="首页"
                android:activated="true" />

            <ImageButton
                android:id="@+id/nav_search"
                style="@style/TVNavItem"
                android:src="@drawable/ic_search"
                android:contentDescription="搜索"
                android:layout_marginTop="4dp" />

            <ImageButton
                android:id="@+id/nav_bookmark"
                style="@style/TVNavItem"
                android:src="@drawable/ic_bookmark"
                android:contentDescription="书签"
                android:layout_marginTop="4dp" />

            <ImageButton
                android:id="@+id/nav_video"
                style="@style/TVNavItem"
                android:src="@drawable/ic_play"
                android:contentDescription="视频工具"
                android:layout_marginTop="4dp" />

            <ImageButton
                android:id="@+id/nav_tabs"
                style="@style/TVNavItem"
                android:src="@drawable/ic_download"
                android:contentDescription="标签页"
                android:layout_marginTop="4dp" />

            <!-- Spacer -->
            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/nav_settings"
                style="@style/TVNavItem"
                android:src="@drawable/ic_settings"
                android:contentDescription="设置" />

        </LinearLayout>

        <!-- ===== Content Area ===== -->
        <LinearLayout
            android:id="@+id/content_zone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#0D0D0D">

            <!-- Address Bar -->
            <LinearLayout
                android:id="@+id/address_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_url_bar_height"
                android:orientation="horizontal"
                android:background="#242424"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="@dimen/tv_nav_button_size"
                    android:layout_height="@dimen/tv_nav_button_size"
                    android:src="@drawable/ic_back"
                    android:background="@drawable/tv_focusable_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:contentDescription="后退" />

                <ImageButton
                    android:id="@+id/btn_forward"
                    android:layout_width="@dimen/tv_nav_button_size"
                    android:layout_height="@dimen/tv_nav_button_size"
                    android:src="@drawable/ic_forward"
                    android:background="@drawable/tv_focusable_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:contentDescription="前进"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/url_bar"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:hint="搜索或输入网址"
                    android:textSize="@dimen/tv_url_bar_text_size"
                    android:textColor="#F0F0F0"
                    android:textColorHint="#666666"
                    android:singleLine="true"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:background="@drawable/tv_focusable_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <ImageButton
                    android:id="@+id/btn_refresh"
                    android:layout_width="@dimen/tv_nav_button_size"
                    android:layout_height="@dimen/tv_nav_button_size"
                    android:src="@drawable/ic_refresh"
                    android:background="@drawable/tv_focusable_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:contentDescription="刷新" />

                <ImageButton
                    android:id="@+id/btn_adblock"
                    android:layout_width="@dimen/tv_nav_button_size"
                    android:layout_height="@dimen/tv_nav_button_size"
                    android:src="@drawable/ic_shield"
                    android:background="@drawable/tv_focusable_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:contentDescription="广告拦截"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:progressTint="#4FC3F7"
                android:visibility="gone" />

            <!-- Tab Container (WebView / Homepage) -->
            <FrameLayout
                android:id="@+id/tab_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </LinearLayout>

    <!-- ===== Overlay Panels (Bookmarks, Settings, Video Tools) ===== -->
    <FrameLayout
        android:id="@+id/panel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#99000000">

        <LinearLayout
            android:id="@+id/panel_container"
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="#242424"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:id="@+id/panel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#4FC3F7"
                android:textSize="20sp"
                android:layout_marginBottom="16dp" />

            <ScrollView
                android:id="@+id/panel_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="400dp">

                <LinearLayout
                    android:id="@+id/panel_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
