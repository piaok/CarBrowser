<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- ExoPlayer PlayerView -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <!-- Control bar overlay at bottom -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC000000"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:visibility="gone">

        <!-- Back 10s -->
        <ImageButton
            android:id="@+id/btnBack10s"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/video_btn_bg"
            android:contentDescription="后退10秒"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back" />

        <!-- Play/Pause -->
        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/video_btn_bg"
            android:contentDescription="播放/暂停"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play" />

        <!-- Forward 10s -->
        <ImageButton
            android:id="@+id/btnForward10s"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/video_btn_bg"
            android:contentDescription="前进10秒"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_forward" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Speed button -->
        <TextView
            android:id="@+id/btnSpeed"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#334CAF50"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="1x"
            android:focusable="true"
            android:clickable="true" />

        <!-- Exit -->
        <ImageButton
            android:id="@+id/btnExit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/video_btn_bg"
            android:contentDescription="退出"
            android:focusable="true"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close" />

    </LinearLayout>

</FrameLayout>
